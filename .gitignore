# Build output. Generated fresh on push and deployed to Pages, never committed.
/site/
/dev/harness/

# Local Pyodide for the e2e tests. Fetched with dev/fetch_pyodide.py, ~30 MB.
/dev/pyodide/

# Vendor toolchain. assets/vendor/ IS committed; what builds it is not.
/vendor-src/node_modules/
/vendor-src/package-lock.json

# The one exception to "assets/vendor/ IS committed": Pyodide's own runtime
# for the downloadable dewmini bundle (build.py's write_dewmini_bundle())
# is fetched with dev/fetch_pyodide.py --out assets/vendor/pyodide, same
# as /dev/pyodide/ above — too large to commit, regenerated on demand
# instead.
/assets/vendor/pyodide/

# Python bytecode.
__pycache__/
*.py[cod]
