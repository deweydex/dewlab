# Build output. Generated fresh on push and deployed to Pages, never committed.
/site/
/dev/harness/

# Local Pyodide for the e2e tests. Fetched with dev/fetch_pyodide.py, ~30 MB.
/dev/pyodide/

# Vendor toolchain. assets/vendor/ IS committed; what builds it is not.
#
# package-lock.json IS committed, and has to be. package.json pins direct
# dependencies exactly, but several of them depend on packages through
# version ranges, and npm installs a separate nested copy whenever a range
# cannot be satisfied by our pin. Without a lockfile those nested copies are
# re-resolved on every install, so a fresh build produces different bundles
# from one day to the next and standalone-bundle-is-current fails on commits
# that changed no code at all. The lockfile freezes them; CI uses `npm ci`,
# which installs exactly what it records.
/vendor-src/node_modules/

# The one exception to "assets/vendor/ IS committed": Pyodide's own runtime
# for the downloadable dewmini bundle (build.py's write_dewmini_bundle())
# is fetched with dev/fetch_pyodide.py --out assets/vendor/pyodide, same
# as /dev/pyodide/ above — too large to commit, regenerated on demand
# instead.
/assets/vendor/pyodide/

# Python bytecode.
__pycache__/
*.py[cod]

# Git worktrees the harness creates for background agents (each one is a
# .git pointer file, not real content — the actual work lands as commits on
# its own branch instead).
/.claude/worktrees/

# Design canvases. The .dc.html artboards and canvas.json under /.design/ ARE
# committed — they are the editable source, and a later change re-seeds from
# them. The assembled page is not: it carries a ~2.5 MB copy of the canvas
# editor, is regenerated by the design skill's seed step, and would dwarf
# every other file in the repository.
/.design/*/*.html
!/.design/*/*.dc.html
