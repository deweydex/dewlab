((=
  The marking copy: a standard nbconvert article with a wide right margin to
  write in, the submission's file name on every page, and no title page of its
  own (the first cell of the notebook is the cover and the points table).
=))
((* extends 'latex/index.tex.j2' *))

((* block margins *))
\geometry{a4paper,verbose,tmargin=0.9in,bmargin=0.9in,lmargin=0.7in,rmargin=2.2in}
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\footnotesize ((( resources['metadata']['name'] | escape_latex )))}
\fancyfoot[C]{\footnotesize\thepage}
% The template's own headings carry their numbers ("1.1 Plan and code"); LaTeX's would double them.
\setcounter{secnumdepth}{-1}
((* endblock margins *))

((* block maketitle *))((* endblock maketitle *))
